generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum UserType {
  TEACHER
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  userType      UserType?
  studentNumber String?   @unique

  accounts      Account[]
  sessions      Session[]
  ownedLabs     Lab[]       @relation("LabOwner")
  memberships   LabMember[]
  assignedTasks Task[]
  materials     Material[]  @relation("MaterialUploader")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Lab {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User        @relation("LabOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   LabMember[]
  tasks     Task[]
  materials Material[]

  @@index([ownerId])
}

model LabMember {
  labId    String
  userId   String   @unique
  joinedAt DateTime @default(now())

  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([labId, userId])
}

model Task {
  id          String     @id @default(cuid())
  labId       String
  title       String
  description String?
  assigneeId  String?
  dueAt       DateTime?  @db.Timestamptz(3)
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lab      Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([labId, status, dueAt])
}

model Material {
  id               String   @id @default(cuid())
  labId            String
  title            String
  description      String?
  originalFileName String
  storageKey       String   @unique
  contentType      String
  sizeBytes        Int
  uploaderId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lab      Lab   @relation(fields: [labId], references: [id], onDelete: Restrict)
  uploader User? @relation("MaterialUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([labId, createdAt])
  @@index([uploaderId])
}
