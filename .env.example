# ローカル開発専用。本番ではこの値を使わないこと。
POSTGRES_DB=material_management
POSTGRES_USER=material_management
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
# このURLの接続先ポートは、上のPOSTGRES_PORTと揃える。
DATABASE_URL="postgresql://material_management:local_dev_only_change_me@127.0.0.1:5432/material_management?schema=public"

# ローカルのSeaweedFSをS3互換ストレージとして使う。接続先はlocalhost内に限定する。
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=material_local_access
S3_SECRET_ACCESS_KEY=local_dev_only_change_me
S3_BUCKET=lab-materials
S3_REGION=us-east-1

# /admin/storageにアクセスできるGoogleアカウントのメールアドレスをカンマで区切る。空欄の場合はアクセスを無効にする。
APP_ADMIN_EMAILS=

# ローカル開発用のAuth.js設定。`npm exec auth secret`でローカル用のシークレットを生成する。
AUTH_SECRET=

# Google Cloudで設定するウェブアプリケーション用のOAuth認証情報。
# OAuthクライアントの設定が済むまでは空欄にする。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
