# Local development only. Do not use these values in production.
POSTGRES_DB=material_management
POSTGRES_USER=material_management
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
# Keep this URL's host port aligned with POSTGRES_PORT above.
DATABASE_URL="postgresql://material_management:local_dev_only_change_me@127.0.0.1:5432/material_management?schema=public"

# Auth.js (local development). Generate a local secret with `npm exec auth secret`.
AUTH_SECRET=

# Google Cloud OAuth Web application credentials.
# Leave these blank until the OAuth client is configured.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
