# ファイルを除外する方法は https://help.github.com/articles/ignoring-files/ を参照。

# 依存パッケージ
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# テストの出力
/coverage

# Next.jsの出力
/.next/
/out/

# 本番ビルドの出力
/build

# OSの管理ファイルと鍵ファイル
.DS_Store
*.pem

# デバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 環境変数ファイル。必要なものは明示的に追跡対象に含める。
.env*
!.env.example

# Vercelのローカル設定
.vercel

# TypeScriptの生成ファイル
*.tsbuildinfo
next-env.d.ts

# prisma/schema.prismaから生成したPrisma Client
/src/generated/prisma/

docs/interview-prep.md
.env*.local
